#include <stdio.h>
#include <string.h>


//     Definição da struct Territorio
//     Essa estrutura agrupa informações relacionadas a um território:
//    - nome: nome do território
//    - cor: cor do exército que domina o território
//    - tropas: quantidade de tropas presentes no território

struct Territorio{
    char nome[30];
    char cor[10];
    int tropas;
};

int main() {

    // Declaração de um vetor para armazenar 5 territórios
    struct Territorio territorios[5];

    int i;

    printf("=====================================\n");
    printf("   CADASTRO DE TERRITORIOS - WAR\n");
    printf("=====================================\n\n");

    // Laço para cadastrar os 5 territórios
    for (i = 0; i < 5; i++) {

        printf("Cadastro do territorio %d\n", i + 1);
        printf("-------------------------------------\n");

        // Entrada do nome do território
        printf("Digite o nome do territorio: ");
        scanf(" %29[^\n]", territorios[i].nome);

        // Entrada da cor do exército
        printf("Digite a cor do exercito (ex: Azul, Amarelo): ");
        scanf(" %9s", territorios[i].cor);

        // Entrada da quantidade de tropas
        printf("Digite a quantidade de tropas: ");
        scanf("%d", &territorios[i].tropas);

        printf("\n");
    }

    // Exibição dos territórios cadastrados
    printf("\n=====================================\n");
    printf("   TERRITORIOS CADASTRADOS\n");
    printf("=====================================\n\n");

    for (i = 0; i < 5; i++) {
        printf("Territorio %d\n", i + 1);
        printf("Nome: %s\n", territorios[i].nome);
        printf("Cor do exercito: %s\n", territorios[i].cor);
        printf("Quantidade de tropas: %d\n", territorios[i].tropas);
        printf("-------------------------------------\n");
    }

    return 0;
}
