#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

struct Territorio {
    char nome[30];
    char cor[10];
    int tropas;
};

// ============================
// COMPARAÇÃO DE STRINGS
// ============================
int compararStrings(char a[], char b[]) {
    int i = 0;

    while (a[i] != '\0' && b[i] != '\0') {
        if (a[i] != b[i])
            return 0;
        i++;
    }

    return a[i] == '\0' && b[i] == '\0';
}

// ============================
// CÓPIA DE STRINGS
// ============================
void copiarString(char destino[], char origem[]) {
    int i = 0;

    while (origem[i] != '\0') {
        destino[i] = origem[i];
        i++;
    }

    destino[i] = '\0';
}

// ============================
// CADASTRO DOS TERRITÓRIOS
// ============================
void cadastrarTerritorios(struct Territorio *t, int n) {

    for (int i = 0; i < n; i++) {

        printf("\n=== Cadastro do Territorio %d ===\n", i + 1);

        printf("Nome: ");
        scanf(" %29[^\n]", t[i].nome);

        printf("Cor do exercito: ");
        scanf(" %9s", t[i].cor);

        do {
            printf("Tropas: ");
            scanf("%d", &t[i].tropas);

        } while (t[i].tropas < 1);
    }
}

// ============================
// LISTAGEM DOS TERRITÓRIOS
// ============================
void listarTerritorios(struct Territorio *t, int n) {

    printf("\n===== TERRITORIOS =====\n");

    for (int i = 0; i < n; i++) {

        printf("[%d] %s | Cor: %s | Tropas: %d\n",
               i,
               t[i].nome,
               t[i].cor,
               t[i].tropas);
    }
}

// ============================
// ATRIBUIR MISSÃO
// ============================
void atribuirMissao(char *destino,
                    char *missoes[],
                    int totalMissoes) {

    int sorteio = rand() % totalMissoes;

    strcpy(destino, missoes[sorteio]);
}

// ============================
// EXIBIR MISSÃO
// ============================
void exibirMissao(char *missao) {

    printf("\n=====================\n");
    printf("MISSAO SORTEADA:\n");
    printf("%s\n", missao);
    printf("=====================\n");
}

// ============================
// VERIFICAR MISSÃO
// ============================
int verificarMissao(char *missao,
                    struct Territorio *mapa,
                    int tamanho) {

    // MISSÃO 1
    if (compararStrings(missao,
        "Conquistar qualquer territorio")) {

        for (int i = 0; i < tamanho; i++) {

            if (mapa[i].tropas > 0)
                return 1;
        }
    }

    // MISSÃO 2
    if (compararStrings(missao,
        "Controlar 2 territorios")) {

        char corJogador[10];

        copiarString(corJogador, mapa[0].cor);

        int contador = 0;

        for (int i = 0; i < tamanho; i++) {

            if (compararStrings(mapa[i].cor,
                                corJogador))
                contador++;
        }

        return contador >= 2;
    }

    // MISSÃO 3
    if (compararStrings(missao,
        "Possuir 5 tropas em um territorio")) {

        for (int i = 0; i < tamanho; i++) {

            if (mapa[i].tropas >= 5)
                return 1;
        }
    }

    // MISSÃO 4
    if (compararStrings(missao,
        "Eliminar a cor Vermelha")) {

        for (int i = 0; i < tamanho; i++) {

            if (compararStrings(mapa[i].cor,
                                "Vermelha"))
                return 0;
        }

        return 1;
    }

    // MISSÃO 5
    if (compararStrings(missao,
        "Conquistar 3 territorios")) {

        char corJogador[10];

        copiarString(corJogador, mapa[0].cor);

        int contador = 0;

        for (int i = 0; i < tamanho; i++) {

            if (compararStrings(mapa[i].cor,
                                corJogador))
                contador++;
        }

        return contador >= 3;
    }

    return 0;
}

// ============================
// ATAQUE
// ============================
void atacar(struct Territorio *atacante,
            struct Territorio *defensor) {

    int dadoAtacante;
    int dadoDefensor;

    printf("\nATAQUE INICIADO!\n");
    printf("%s vs %s\n",
           atacante->nome,
           defensor->nome);

    do {

        dadoAtacante = rand() % 6 + 1;
        dadoDefensor = rand() % 6 + 1;

        printf("Atacante: %d | Defensor: %d\n",
               dadoAtacante,
               dadoDefensor);

        if (dadoAtacante == dadoDefensor)
            printf("Empate! Repetindo...\n");

    } while (dadoAtacante == dadoDefensor);

    if (dadoAtacante > dadoDefensor) {

        printf("Atacante venceu!\n");

        defensor->tropas--;

        if (defensor->tropas <= 0) {

            copiarString(defensor->cor,
                         atacante->cor);

            int tropasTransferidas =
                atacante->tropas / 2;

            if (tropasTransferidas < 1)
                tropasTransferidas = 1;

            atacante->tropas -= tropasTransferidas;

            defensor->tropas =
                tropasTransferidas;

            printf("Territorio conquistado!\n");
        }

    } else {

        printf("Defensor venceu!\n");

        atacante->tropas--;
    }

    if (atacante->tropas < 1)
        atacante->tropas = 1;
}

// ============================
// LIBERAR MEMÓRIA
// ============================
void liberarMemoria(struct Territorio *t,
                    char *missao) {

    free(t);
    free(missao);
}

// ============================
// MAIN
// ============================
int main() {

    int n;
    int opcao;

    srand(time(NULL));

    char *missoes[] = {
        "Conquistar qualquer territorio",
        "Controlar 2 territorios",
        "Possuir 5 tropas em um territorio",
        "Eliminar a cor Vermelha",
        "Conquistar 3 territorios"
    };

    int totalMissoes = 5;

    printf("Quantos territorios deseja cadastrar? ");
    scanf("%d", &n);

    struct Territorio *territorios =
        malloc(n * sizeof(struct Territorio));

    if (territorios == NULL) {

        printf("Erro de memoria!\n");
        return 1;
    }

    char *missaoJogador =
        malloc(100 * sizeof(char));

    if (missaoJogador == NULL) {

        printf("Erro de memoria!\n");

        free(territorios);

        return 1;
    }

    cadastrarTerritorios(territorios, n);

    atribuirMissao(
        missaoJogador,
        missoes,
        totalMissoes);

    exibirMissao(missaoJogador);

    do {

        printf("\n===== MENU =====\n");
        printf("1 - Listar territorios\n");
        printf("2 - Atacar\n");
        printf("0 - Sair\n");
        printf("Escolha: ");

        scanf("%d", &opcao);

        if (opcao == 1) {

            listarTerritorios(
                territorios,
                n);
        }

        else if (opcao == 2) {

            int a;
            int d;

            listarTerritorios(
                territorios,
                n);

            printf("Indice do ATACANTE: ");
            scanf("%d", &a);

            printf("Indice do DEFENSOR: ");
            scanf("%d", &d);

            if (a < 0 || a >= n ||
                d < 0 || d >= n) {

                printf("Indices invalidos!\n");
                continue;
            }

            if (compararStrings(
                territorios[a].cor,
                territorios[d].cor)) {

                printf("Mesma cor nao pode atacar!\n");
                continue;
            }

            if (territorios[a].tropas < 2) {

                printf("Tropas insuficientes!\n");
                continue;
            }

            atacar(
                &territorios[a],
                &territorios[d]);

            listarTerritorios(
                territorios,
                n);

            if (verificarMissao(
                missaoJogador,
                territorios,
                n)) {

                printf("\n=================================\n");
                printf("MISSAO CUMPRIDA!\n");
                printf("VOCE VENCEU O JOGO!\n");
                printf("=================================\n");

                break;
            }
        }

    } while (opcao != 0);

    liberarMemoria(
        territorios,
        missaoJogador);

    printf("\nFim do programa.\n");

    return 0;
}
